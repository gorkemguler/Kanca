# Go
*.exe
*.test
*.out
/kanca
/cmd/kanca/kanca

# Node / frontend
node_modules/
desktop/frontend/.vite/

# Wails build output. We keep only the app icon; Wails regenerates the per-OS
# packaging scaffolding (build/darwin, build/windows) from it on `wails build`.
desktop/build/*
!desktop/build/appicon.png
desktop/frontend/dist/*
!desktop/frontend/dist/.gitkeep

# Wails generated bindings and dev artifacts (regenerated by `wails dev`)
desktop/frontend/wailsjs/
desktop/frontend/package.json.md5

# Local runtime state (root CA lives in the user's home by default)
.kanca/

# Editor / OS
.DS_Store
.idea/
.vscode/

# stray desktop build binary
/desktop/desktop
